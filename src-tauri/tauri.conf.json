{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musicfree",
  "version": "0.2.7",
  "identifier": "dev.chrystianschmith.musicfree",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Musicfree",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "backgroundColor": "#111114"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Reprodutor de música rápido e minimalista",
    "category": "Music",
    "copyright": "© 2026 Chrystian Schmith",
    "longDescription": "Reprodutor de música para desktop, rápido e minimalista, com o catálogo do YouTube Music, letras sincronizadas e recomendações locais.",
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
