{
  "name": "musicfree",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 1420",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "smoke": "SMOKE=1 vitest run",
    "screenshots": "SCREENSHOTS=1 playwright test screenshots.spec.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sql.js": "^1.15.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "description": "A fast, minimal desktop music player for YouTube Music",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}
